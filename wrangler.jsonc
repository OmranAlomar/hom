{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "albukur",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "DB", "id": "ضع_معرّف_KV_هنا" }
  ],
  "vars": {
    "MAX_USERS": "9"
  }
}
